{
  "name": "karabiner-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "service": "bun packages/service/src/main.ts",
    "cli": "bun packages/cli/src/main.ts",
    "typecheck": "tsc --noEmit",
    "build:service": "bun run --cwd packages/service build",
    "build:cli": "bun run --cwd packages/cli build",
    "build:client": "cargo build -p karabiner-client",
    "smoke": "bun .groundwork/scripts/service-smoke.ts"
  },
  "devDependencies": { "@types/bun": "1.3.14", "typescript": "7.0.2" }
}
